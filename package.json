{
  "name": "movie-scrapper",
  "version": "0.0.6",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "format": "prettier -w \"{src,tests}/**/*.{ts,tsx}\"",
    "lint": "eslint \"{src,tests}/**/*.{ts,tsx}\"",
    "test:unit": "vitest run --coverage",
    "start:dev": "nodemon -r dotenv/config --inspect=9999 src/index.ts",
    "version:patch": "fethca-version patch",
    "version:minor": "fethca-version minor",
    "version:major": "fethca-version major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fethca/movie-scrapper.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fethca/movie-scrapper/issues"
  },
  "homepage": "https://github.com/fethca/movie-scrapper#readme",
  "dependencies": {
    "@fethcat/config": "^0.1.0",
    "@fethcat/logger": "^1.1.0",
    "@fethcat/shared": "^0.1.0",
    "@fethcat/store": "^0.1.0",
    "@fethcat/validator": "^0.1.0",
    "axios": "^1.21.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "envalid": "^8.2.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "lodash.isequal": "^4.5.0",
    "lodash.uniq": "^4.5.0",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fethcat/eslint-plugin": "^0.0.3",
    "@fethcat/prettier-config": "^1.0.5",
    "@fethcat/tests": "^0.1.0",
    "@fethcat/version": "^0.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.uniq": "^4.5.9",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "mockdate": "^3.0.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "prettier": "@fethcat/prettier-config",
  "nodemonConfig": {
    "restartable": "rs",
    "ignore": [
      ".git",
      "node_modules/**/node_modules"
    ],
    "execMap": {
      "ts": "tsx"
    },
    "watch": [
      "src/"
    ],
    "ext": "js,json,ts"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@fethcat/back"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
